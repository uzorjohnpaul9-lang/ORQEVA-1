# Public build-time config for the dashboard bundle.
#
# These values are embedded in the client bundle by design - NEXT_PUBLIC_*
# values are shipped to the browser. The Supabase key here is the
# *publishable* (low-privilege, RLS-scoped) key, not the secret key.
# Committed so CI builds and local builds produce identical output.
#
# The backend is on Railway; only the dashboard is served by Cloudflare Pages.

NEXT_PUBLIC_SUPABASE_URL=https://crysjnakhwveokjrydyw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VYLZNBFGZJ9UFV3zIEM_1g_pV9fBW6J
NEXT_PUBLIC_API_URL=https://orqeva-1-production.up.railway.app
