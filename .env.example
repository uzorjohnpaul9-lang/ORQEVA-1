# Copy to .env and fill in. Names here must match what the code reads in
# backend/config.py - renaming one silently disables the feature.
# ============================
# SUPABASE (Auth + PostgREST - the AI-trading backend runs on this)
# Dashboard -> Project Settings -> API Keys
#   Project URL        -> SUPABASE_URL
#   publishable key    -> SUPABASE_PUBLISHABLE_KEY (low-priv, anon + RLS)
#   secret key         -> SUPABASE_SECRET_KEY         (server-only, BYPASSRLS)
# ============================
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names, still accepted as fallbacks if you have not migrated:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# Only needed for legacy HS256 local token verification. Modern auth is verified
# server-side via Supabase, so this is usually empty.
SUPABASE_JWT_SECRET=

# Public URL of the backend - gateways call this back on webhooks
# (e.g. https://orqeva-1-production.up.railway.app).
APP_BASE_URL=http://localhost:8000
# Public URL of the frontend - where browsers land after payment and where
# password-reset/billing links point. Empty falls back to APP_BASE_URL.
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated (or a JSON array). Defaults to localhost:3000 + the Pages origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://orqeva.pages.dev
# false in production. Only DEBUG=true tolerates a placeholder ENCRYPTION_KEY.
DEBUG=false

# ============================
# Database - Supabase only; the backend never opens a Postgres connection.
# Apply supabase/migrations/*.sql, not this file.
# DASHBOARD_DATABASE_URL is used by the legacy sync system (data/).
# ============================
DASHBOARD_DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:5432/postgres
# Legacy engines/ + data/ only:
DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0

# ============================
# Market data
# ============================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# NOTE: underscore between TWELVE and DATA. docker-compose.yml previously passed
# TWELVEDATA_API_KEY, which no code reads - forex/crypto/gold quotes were dead.
TWELVE_DATA_API_KEY=

# ============================
# Security
# ============================
# Generates the key that encrypts stored broker API credentials. Changing it makes
# every saved credential undecryptable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Only used by the legacy JWT helpers. Auth is verified via Supabase.
SECRET_KEY=

# ============================
# Telegram (one bot per tier + one dedicated admin bot)
# Run: python setup_telegram.py  (validates tokens and writes these keys)
# ============================
TELEGRAM_BOT_TOKEN_FREE=
TELEGRAM_BOT_TOKEN_PREMIUM=
TELEGRAM_BOT_TOKEN_VIP=
# Admin/payment alerts. Falls back to the Free bot when empty.
TELEGRAM_BOT_TOKEN_ADMIN=
# Channel IDs the tier bots post signals to (bots must be channel admins
# with "post messages" permission). Fetch with: python get_channel_id.py
TELEGRAM_CHANNEL_FREE=
TELEGRAM_CHANNEL_PREMIUM=
TELEGRAM_CHANNEL_VIP=
# Subscriber chat IDs (comma-separated), used by notifications/tiered_notifier.py
TELEGRAM_CHAT_IDS_FREE=
TELEGRAM_CHAT_IDS_PREMIUM=
TELEGRAM_CHAT_IDS_VIP=
TELEGRAM_ADMIN_CHAT_ID=

# ============================
# Email - password reset and alerts. No-ops when SMTP_HOST is empty.
# Legacy names (SMTP_SERVER / SENDER_EMAIL / SENDER_PASSWORD) are accepted as aliases.
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ORQEVA <no-reply@orqeva.com>

# ============================
# Payments - Bachs (hosted checkout: card, bank transfer, mobile money, crypto)
# https://docs.bachs.io
# BACHS_API_KEY is the secret key. sk_sandbox_... targets
# https://sandbox-api.bachs.io, sk_live_... targets https://api.bachs.io.
# BACHS_WEBHOOK_SECRET is the signing secret shown on the webhook endpoint
# in the Bachs developer portal.
# BACHS_API_URL is optional and overrides the base URL derived from the key.
# Pin it to the sandbox while testing so a live key fails closed (401) instead
# of silently taking real money:
#   BACHS_API_URL=https://sandbox-api.bachs.io   (sandbox)
#   BACHS_API_URL=https://api.bachs.io            (production)
# ============================
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_URL=

# ============================
# Background scan scheduler
# ============================
SCAN_ENABLED=false
SCAN_INTERVAL_MINUTES=15
SCAN_COOLDOWN_HOURS=4
# Auto-trade gate: false blocks every live/paper auto-trade path.
TRADING_ENABLED=false

# ============================
# Economic calendar (scheduled market events) - keyless, free source.
# Powers the in-app Calendar page, the Overview banner and Telegram
# event-ahead warnings. Attribution to financecalendar.com is required.
#   CALENDAR_ENABLED: set to 0 to disable calendar lookups
#   EVENT_ALERT_WINDOW_MINUTES: how far ahead to warn / flag signals
# ============================
CALENDAR_ENABLED=true
CALENDAR_BASE_URL=https://www.financecalendar.com/wp-json/fc/v1
EVENT_ALERT_WINDOW_MINUTES=30

# ============================
# Academy / AI Instructor (backend/services/llm_service.py reads these via env)
# Provider-agnostic. With no key set the Instructor runs in GUIDED MODE
# (scripted teaching content); set a key to switch it to the live model.
#   LLM_PROVIDER: openai | anthropic | gemini   (default: openai)
#   LLM_MODEL:    overrides the per-provider default below
# Defaults per provider: gpt-4o-mini / claude-3-5-sonnet-latest / gemini-1.5-flash
# ============================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ============================
# Monitoring
# ============================
SENTRY_DSN=
# Sentry is auto-disabled under pytest so test runs don't spam the project.
# Set SENTRY_FORCE=1 to override (e.g. to test Sentry integration locally).
SENTRY_FORCE=
LOG_LEVEL=INFO
LOG_FILE=

# ============================
# Admin account seeded into Supabase Auth on every backend boot.
# Seeded only if it does not already exist.
# ============================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
# Set to 1 to force the seeded admin's password back to ADMIN_PASSWORD on boot
# (use after losing the admin password; remove afterwards).
ADMIN_SEED_FORCE=