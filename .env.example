# Copy to .env and fill in. Names here must match what the code reads in
# backend/config.py - renaming one silently disables the feature.
# ============================
# SUPABASE (Auth + PostgREST - the AI-trading backend runs on this)
# Dashboard -> Project Settings -> API Keys
#   Project URL        -> SUPABASE_URL
#   publishable key    -> SUPABASE_PUBLISHABLE_KEY (low-priv, anon + RLS)
#   secret key         -> SUPABASE_SECRET_KEY         (server-only, BYPASSRLS)
# ============================
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names, still accepted as fallbacks if you have not migrated:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# Only needed for legacy HS256 local token verification. Modern auth is verified
# server-side via Supabase, so this is usually empty.
SUPABASE_JWT_SECRET=

# Public URL of the frontend - used to build password-reset links.
APP_BASE_URL=http://localhost:3000
# Comma-separated (or a JSON array). Defaults to localhost:3000 + the Pages origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://orqeva.pages.dev
# false in production. Only DEBUG=true tolerates a placeholder ENCRYPTION_KEY.
DEBUG=false

# ============================
# Database - Supabase only; the backend never opens a Postgres connection.
# Apply supabase/migrations/*.sql, not this file.
# DASHBOARD_DATABASE_URL is used by the legacy sync system (data/).
# ============================
DASHBOARD_DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:5432/postgres
# Legacy engines/ + data/ only:
DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0

# ============================
# Market data
# ============================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# NOTE: underscore between TWELVE and DATA. docker-compose.yml previously passed
# TWELVEDATA_API_KEY, which no code reads - forex/crypto/gold quotes were dead.
TWELVE_DATA_API_KEY=

# ============================
# Security
# ============================
# Generates the key that encrypts stored broker API credentials. Changing it makes
# every saved credential undecryptable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Only used by the legacy JWT helpers. Auth is verified via Supabase.
SECRET_KEY=

# ============================
# Telegram (one bot per tier + one dedicated admin bot)
# Run: python setup_telegram.py  (validates tokens and writes these keys)
# ============================
TELEGRAM_BOT_TOKEN_FREE=
TELEGRAM_BOT_TOKEN_PREMIUM=
TELEGRAM_BOT_TOKEN_VIP=
# Admin/payment alerts. Falls back to the Free bot when empty.
TELEGRAM_BOT_TOKEN_ADMIN=
# Channel IDs the tier bots post signals to (bots must be channel admins
# with "post messages" permission). Fetch with: python get_channel_id.py
TELEGRAM_CHANNEL_FREE=
TELEGRAM_CHANNEL_PREMIUM=
TELEGRAM_CHANNEL_VIP=
# Subscriber chat IDs (comma-separated), used by notifications/tiered_notifier.py
TELEGRAM_CHAT_IDS_FREE=
TELEGRAM_CHAT_IDS_PREMIUM=
TELEGRAM_CHAT_IDS_VIP=
TELEGRAM_ADMIN_CHAT_ID=

# ============================
# Email - password reset and alerts. No-ops when SMTP_HOST is empty.
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ORQEVA <no-reply@orqeva.com>

# ============================
# Background scan scheduler
# ============================
SCAN_ENABLED=false
SCAN_INTERVAL_MINUTES=15
SCAN_COOLDOWN_HOURS=4
# Auto-trade gate: false blocks every live/paper auto-trade path.
TRADING_ENABLED=false

# ============================
# Monitoring
# ============================
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FILE=

# ============================
# Admin account seeded into Supabase Auth on every backend boot.
# Seeded only if it does not already exist.
# ============================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
# Set to 1 to force the seeded admin's password back to ADMIN_PASSWORD on boot
# (use after losing the admin password; remove afterwards).
ADMIN_SEED_FORCE=