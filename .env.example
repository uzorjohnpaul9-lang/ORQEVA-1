# ============================
# SUPABASE (Auth + PostgREST - the AI-trading backend runs on this)
# Dashboard -> Project Settings -> API
#   Project URL                     -> SUPABASE_URL
#   anon / publishable key          -> SUPABASE_ANON_KEY
#   service_role / secret key       -> SUPABASE_SERVICE_KEY (server-side, keep secret)
#   JWT secret / "JWT Secret"       -> SUPABASE_JWT_SECRET (Authentication -> JWT Settings)
# ============================
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ============================
# Legacy sync trading system (engines/, data/, risk/) - psycopg2, keep for legacy
# ============================
DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:5432/postgres

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379/0

# Trading Configuration
TRADING_ENABLED=false
DEFAULT_RISK_PROFILE=conservative
MAX_PORTFOLIO_VALUE=100000

# Security (auto-generated - rotate before production)
SECRET_KEY=change_me
ENCRYPTION_KEY=change_me

# Monitoring
SENTRY_DSN=your_sentry_dsn
PROMETHEUS_PORT=9090

# Alpaca API
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Telegram channels (one per tier)
TELEGRAM_BOT_TOKEN_FREE=your_free_bot_token
TELEGRAM_BOT_TOKEN_PREMIUM=your_premium_bot_token
TELEGRAM_BOT_TOKEN_VIP=your_vip_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Email alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# Admin (the account that becomes is_admin=true / tier=vip in Supabase Auth)
# Every backend boot force-syncs this account's password to ADMIN_PASSWORD.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me
